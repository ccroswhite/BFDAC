(symbol (lib_id "Relay:G6K-2") (at 100.330 69.850 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "ae9ae69f-342e-4976-ad7b-0f629d533e4e") (property "Reference" "K601" (at 103.330 68.550 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "G6K-2F-Y DC3" (at 103.330 71.150 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "Relay_SMD:Relay_DPDT_Omron_G6K-2F-Y" (at 100.330 69.850 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 100.330 69.850 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "K4 line mute, Omron G6K-2F-Y 2 Form C single-side stable, 3 V coil 91 R / 33.0 mA / ~100 mW held (en-g6k p.3, verified 2026-10-10; must operate 80 % max, release 10 % min, 150 % max) on the dedicated 3.3 V V33RLY rail (U603): 3.3 V - ULN V_sat ~0.3 V = 3.0 V = 100 % rated (DC12 on V12SOM struck 2026-10-10: 12 V is SoM-only), bifurcated crossbar Ag/Au-alloy contacts, P-level 10 uA @ 10 mV, SMD; pins (KiCad Relay:G6K-2 graphics = user's GN reading): coil 1(+)/8, COM 3/6, NC 2/7, NO 4/5; NC = XLR pin to GND, NO = I/V output, coil off = muted (bom 7, 2026-10-08). Ambient limit 70 C - rear-panel edge placement, verify with the TMP117 ambient sensor" (at 100.330 69.850 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "G6K-2F-Y DC3" (at 100.330 69.850 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "311481af-a15f-491a-818b-d3cd6ad26668")) (pin "2" (uuid "52d70c01-2915-48b5-8c1e-5cd26e08332b")) (pin "3" (uuid "e248272e-a9f7-4515-bede-18ec7e95ee63")) (pin "4" (uuid "530eb4bd-2250-46ba-9aa9-d21cf952fbd7")) (pin "5" (uuid "d20ad58f-7c43-49ee-90f2-32b244b4eddf")) (pin "6" (uuid "75bdb75e-853b-4a1f-9293-06b2922c8f66")) (pin "7" (uuid "cb3a1e37-fffe-4c1f-b1b3-9e657a1d8183")) (pin "8" (uuid "8807358c-94be-4c3b-8021-1fd85d304390")) (instances (project "bfdac_analog" (path "/e214d457-f1e0-46ff-82ae-9c5220de0889/b294a5d4-9b02-43fd-b071-86e523130