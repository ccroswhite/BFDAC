(symbol (lib_id "Relay:G6K-2") (at 100.330 139.700 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "f7c7c88c-31c6-4b23-b34f-1b44242df47a") (property "Reference" "K602" (at 103.330 138.400 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "G6K-2F-Y DC3" (at 103.330 141.000 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "Relay_SMD:Relay_DPDT_Omron_G6K-2F-Y" (at 100.330 139.700 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 100.330 139.700 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "K4 line mute, Omron G6K-2F-Y 2 Form C single-side stable, 3 V coil 91 R / 33.0 mA / ~100 mW held (en-g6k p.3, verified 2026-10-10; must operate 80 % max, release 10 % min, 150 % max) on the dedicated 3.3 V V33RLY rail (U603): 3.3 V - ULN V_sat ~0.3 V = 3.0 V = 100 % rated (DC12 on V12SOM struck 2026-10-10: 12 V is SoM-only), bifurcated crossbar Ag/Au-alloy contacts, P-level 10 uA @ 10 mV, SMD; pins (KiCad Relay:G6K-2 graphics = user's GN reading): coil 1(+)/8, COM 3/6, NC 2/7, NO 4/5; NC = XLR pin to GND, NO = I/V output, coil off = muted (bom 7, 2026-10-08). Ambient limit 70 C - rear-panel edge placement, verify with the TMP117 ambient sensor" (at 100.330 139.700 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "G6K-2F-Y DC3" (at 100.330 139.700 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "90cbcde5-1613-439d-af5b-8a4b09c6737f")) (pin "2" (uuid "48e40f76-3712-4cad-8596-e9e00a757bac")) (pin "3" (uuid "de0d61de-aa00-46c4-a9a9-c26ca405b635")) (pin "4" (uuid "b0abfc45-6eee-4550-88b7-bde6a1a0bf5b")) (pin "5" (uuid "82f25404-8fed-44ab-a0d7-9608961a33e7")) (pin "6" (uuid "72193bc9-6c62-4427-95c8-f917e2d84877")) (pin "7" (uuid "96d5b3af-16a4-4ebb-8382-981665cad4d8")) (pin "8" (uuid "e453b893-3f86-49f8-a76e-aa1fa535b1c9")) (instances (project "bfdac_analog" (path "/e214d457-f1e0-46ff-82ae-9c5220de0889/b294a5d4-9b02-43fd-b071-86