(symbol (lib_id "Regulator_Linear:TPS7A20xxxDBV") (at 199.390 229.870 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "5b2af361-35bc-4bd1-8643-da4f1ebde7bb") (property "Reference" "U603" (at 202.390 228.570 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "TPS7A2033" (at 202.390 231.170 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "Package_TO_SOT_SMD:SOT-23-5" (at 199.390 229.870 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 199.390 229.870 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "dedicated relay-coil LDO: 3.3 V fixed, 300 mA, SOT-23-5, from the 4.3 V pre-reg V4P3 (1.0 V headroom; V_DO 140 mV max at 300 mA), load 2 x 33 mA coils + flyback. EN = UNMUTE_EN (V_EN(HI) 0.9 V max vs 1.65 V min from U602; 500k internal pull-down = rail absent until DONE AND PG_ALL AND GPIO - second hardware mute path independent of U601; t_start 0.75-1.15 ms). Keeps coil steps / flyback off V33D (TMP117, ISO1640). TI SBVS338H, datasheets/TI_TPS7A20.pdf, 2026-10-10" (at 199.390 229.870 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "TPS7A2033PDBVR" (at 199.390 229.870 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "50df63d4-f625-49c6-9cd6-ce5274a91623")) (pin "2" (uuid "96d42cb2-643c-49c5-a16c-b6de8b848e60")) (pin "3" (uuid "5af965db-9d1f-4331-86a7-4751fe190273")) (pin "4" (uuid "463a0cdf-8816-4835-91c9-4aba513a0260")) (pin "5" (uuid "0a17803f-eb94-456e-9efd-0072a3f24b69")) (instances (project "bfdac_analog" (path "/e214d457-f1e0-46ff-82ae-9c5220de0889/b294a5d4-9b02-43fd-b071-86e523130871" (reference "U603") (unit 1)))))
