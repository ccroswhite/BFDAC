(text "V33CLK LDO (U340): LT3045 from V4P3_LA (bom 17n branch allocation: clock tree rides the quiet LA branch), ~500 mA stereo clock tree + XOs; PG -> PG_ALL (wired-AND on the POWER sheet)." (exclude_from_sim no) (at 20.000 555.000 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "01c41d30-7798-4fd2-9dba-aebc4aef18ec"))
(symbol (lib_id "Regulator_Linear:LT3045xMSE") (at 90.170 480.060 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "a422a475-21d5-4633-88f5-cdc06acfd6b0") (property "Reference" "U340" (at 93.170 478.760 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "LT3045" (at 93.170 481.360 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "Package_SO:MSOP-12-1EP_3x4.039mm_P0.65mm_EP1.651x2.845mm_ThermalVias" (at 90.170 480.060 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 90.170 480.060 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "500 mA ultralow-noise LDO; SET = 100 uA x R_SET to GND (150k = 15.0 V, 33.2k = 3.32 V; RG1608N 0.05 %) or driven by VE1_SET (REFS sheet). EN/UV->IN, ILIM->GND, PGFB divider per rail + 1 nF (bom 17(m): 887k/20k for +15 V, 412k/20k VE1, 180k/20k for 3.3 V class), PG open-collector -> PG_ALL, OUTS Kelvin to the output cap" (at 90.170 480.060 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "LT3045EMSE#PBF" (at 90.170 480.060 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "12dceeeb-96c2-4c7f-bf01-09c42bbb1a49")) (pin "2" (uuid "2e7090fa-d73d-48fa-ba94-01e3aa30f034")) (pin "3" (uuid "b456110a-e1f9-4e77-8b04-756d09f28b64")) (pin "4" (uuid "9c163b30-faaf-46a6-9cbb-006b57457b69")) (pin "5" (uuid "9ba5b671-d122-40a8-955c-8283dfc601c4")) (pin "6" (uuid "be862fba-0061-45b8-ba33-3ea079d500fe")) (pin "7" (uuid "44f037f8-3ad8-4842-a383-e3ba9b3d6f46")) (pin "8" (uuid "6330b335-51e5-476c-a176-28430d3ed325")) (pin "9" (uuid "7e7d6947-3981-41d0-a1b6-aef425c8d820")) (pin "10" (uuid "6ef798ac-f7d5-40b3-8557-40985220e4b0")) (pin "11" (uuid "a9891ce6-8440-48cb-bdde-91f4ef474851")) (pin "12" (uuid "ec51b442-9bbd-40ef-b205-3ce846a29b41")) (pin "13" (uuid "61c403ab-4d29-4db5-a4f9-a3341c2ba557")) (instances (project "bfdac_analog" (path "/9f62f5bd-075e-47da-9c2c-bd7bdc124dc7/518338b4-1889-4253-8a17-ac6d00d3e9a