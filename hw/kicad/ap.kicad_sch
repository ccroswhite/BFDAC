(symbol (lib_id "Device:D_TVS") (at 59.690 115.570 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board no) (dnp no) (uuid "526fced9-cb69-4b97-9bd9-945a7d7b6051") (property "Reference" "D852" (at 62.690 114.270 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "SMBJ5.0A" (at 62.690 116.870 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "Diode_SMD:D_SMB" (at 59.690 115.570 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 59.690 115.570 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "VBUS surge/ESD clamp at J852, cable-side island (USB_VBUS -> USB_GND).  5 V standoff (VBUS max 5.25), Vbr 6.4-7.0, Vclamp 9.2 @ 65.3 A, 600 W 10/1000us.  Protects ISOUSB211 VBUS1 (abs max ~6-7 V) fast edge; C851/C852 absorb the residue.  JEDEC DO-214AA (SMB) - no vendor fp needed; drop-in alternates same land: ST SMBJ5.0A-TR (~37k DigiKey), Bourns/Eaton/YAGEO SMBJ5.0A, Diodes SMAJ5.0A-13-F (SMA body - smaller pad), Nexperia PTVS5V0S1UR,115 (SOD-123W - different pad).  Sustained overvolt NOT covered (keyed USB-C, UFP - no PD negotiation -> 5 V only; a dead host regulator is pathological).  No series diode - drop would break the 4.25 V VBUS1 min at 4.75 V VBUS." (at 59.690 115.570 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "SMBJ5.0A (PROPOSED - Littelfuse; ~2.5k Newark 2026-11; cross-check supply)" (at 59.690 115.570 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "55ab0d37-a3da-4793-ba30-60001cef0b81")) (pin "2" (uuid "fb6a241e-4fab-46fd-a150-4e294e6ec680")) (instances (project "bfdac_analog" (path "/e214d457-f1e0-46ff-82ae-9c5220de0889/5180a859-fbe3-4de7-8d1c-6a68d391933f" (reference "D852") (unit 1)))))
