(symbol (lib_id "bfdac:TPS3890") (at 510.540 379.730 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board no) (dnp no) (uuid "fba6ab9f-1941-4e58-b1b3-17dff523ae8f") (property "Reference" "U856" (at 513.540 378.430 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "TPS389001" (at 513.540 381.030 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "Package_SON:WSON-6_1.5x1.5mm_P0.5mm" (at 510.540 379.730 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 510.540 379.730 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "VAP18 supervisor = the whole sequencer (XMOS-prescribed discrete chain; UCD90120A rejected as overkill: $15 13-rail PMBus monitor for a 3-rail/1-pin sequence).  SENSE watches VAP18 via 39.2k/90.9k -> ~1.65 V trip (VDDIOB18 min 1.62 V).  VDD = VAP_IO (alive while VAP18 collapses), MR->VDD, CT->C882 (verified eq.1: 10 nF ~ 11 ms deassert delay).  RESET open-drain -> AP09_EN: the core buck cannot start until the 1.8 V IO bank is proven valid" (at 510.540 379.730 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "TPS389001DSET (PROPOSED - same part as U1701/U1702 on the carrier)" (at 510.540 379.730 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "4" (uuid "6e1de5d3-7414-4208-9774-4aeb4d3bf300")) (pin "3" (uuid "669841fb-0abd-4b8b-b44b-27f1e9d05e84")) (pin "5" (uuid "db9ab64f-28ac-493f-8d52-66e85c6f4ade")) (pin "1" (uuid "526ccf8a-fe4e-413d-8f6f-6d54070158c3")) (pin "6" (uuid "e86f57c7-63c1-4d83-82fe-187e5137e691")) (pin "2" (uuid "74fca4f5-747a-437d-9cf8-481e77398e24")) (instances (project "bfdac_analog" (path "/e214d457-f1e0-46ff-82ae-9c5220de0889/5180a859-fbe3-4de7-8d1c-6a68d391933f" (reference "U856") (unit 1)))))
