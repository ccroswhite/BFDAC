(text "XMOS decoupling per the datasheet checklist: 100 n per VDD pin (x12 incl. the four VDD paddles) + per IO-bank pin, >= 10 u bulk on each rail, all grounded straight to the paddle-side plane.  Caps shown here are representative; final count is set at layout." (exclude_from_sim no) (at 300.000 300.000 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "fbf7fd45-b907-41d1-a8c9-30e5a96ee617"))
(symbol (lib_id "Connector_Generic:Conn_01x04") (at 129.540 229.870 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board no) (dnp no) (uuid "479da8a0-dcda-4ec7-92ba-7de3d6e0cafb") (property "Reference" "J854" (at 132.540 228.570 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "+3V3-DC" (at 132.540 231.170 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "Connector_Phoenix_MSTB:PhoenixContact_MSTBV_2,5_4-GF-5,08_1x04_P5.08mm_Vertical_ThreadedFlange_MountHole" (at 129.540 229.870 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 129.540 229.870 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "Phoenix MSTBV 2,5/4-GF-5,08 vertical header, 4-pos 5.08 mm, threaded flange + board mount holes, 12 A / 320 V - RS-25-3.3 DC output landing in the AP section (J854): pins 1-2 = +3.3 V -> VAP_IO, pins 3-4 = -V return -> GND_AP; mate = MSTB 2,5/4-STF-5,08 screw-clamp plug; USER-RULED 2026-11-01" (at 129.540 229.870 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "1777099" (at 129.540 229.870 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "692b989e-535b-4217-9432-bbf78778d651")) (pin "2" (uuid "1952f5fc-37ea-4b90-acbb-2f1e1dafef0f")) (pin "3" (uuid "66010445-8ee3-4a45-b323-26e7345f268f")) (pin "4" (uuid "5367d4b5-b8b2-49c2-aea4-c2fdb1557d00")) (instances (project "bfdac_analog" (path "/e214d457-f1e0-46ff-82ae-9c5220de0889/5180a859-fbe3-4de7-8d1c-6a68d391933f" (reference "J854") (unit 1)))))
