(symbol (lib_id "Connector_Generic:Conn_02x10_Odd_Even") (at 389.890 165.100 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board no) (dnp no) (uuid "04dc9fed-21d0-49dc-ab06-c42823dff298") (property "Reference" "J851" (at 392.890 163.800 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "XSYS2" (at 392.890 166.400 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "Connector_PinHeader_1.27mm:PinHeader_2x10_P1.27mm_Vertical_SMD" (at 389.890 165.100 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 389.890 165.100 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "XMOS xSYS2 debug receptacle (XTAG4 20-pin 0.05in IDC ribbon, keyed shroud) - JTAG-only subset per XU316 ds App F.2: pin 1 VREF_JTAG = VAP18 (1.8 V JTAG group), 2 TMS, 4 TCK, 6 TDO, 8 TDI, 10 RST_N, 3/5/7/9 GND_AP; pins 11-20 (VREF_LINK + xLINK on X1D16-19) NC - X1D16 is committed to USB_ATTACH and XMOS rates the link advanced-debug-only. xflash over XTAG4 programs U853 through JTAG (ds sec 12).  ** VERIFY MPN + land pattern **" (at 389.890 165.100 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "FTSH-110-01-F-DV-K-TR  ** PROPOSED **" (at 389.890 165.100 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "22001b62-67ca-47b2-b70d-b4b8c33893bd")) (pin "2" (uuid "1d447837-9118-449e-92e0-eccf56f5fb2a")) (pin "3" (uuid "ffa0574e-a26b-4553-b3ac-089fc7a9aebb")) (pin "4" (uuid "c28e40da-43cd-455c-b445-0492cf447db4")) (pin "5" (uuid "b0b2f5db-f14e-46cf-be13-6f2b8b7c000b")) (pin "6" (uuid "37ae615f-93ad-4a75-82e4-8037432bd93c")) (pin "7" (uuid "fdc66c4e-d5a7-4ce4-aba3-e6c15e94be42")) (pin "8" (uuid "fe072191-8eb3-44d3-a328-e0203db7b1fc")) (pin "9" (uuid "63036111-ea29-4753-8036-1f6ac5ad6ae2")) (pin "10" (uuid "9d003b9a-1c7d-4384-8de1-8d50c017627d")) (pin "11" (uuid "1d611628-dd70-4172-9ab6-37b0cb2a0fb6")) (pin "12" (uuid "2a174379-7cc4-493e-9997-bbac20f6f838")) (pin "13" (uuid "de8c7f82-f84b