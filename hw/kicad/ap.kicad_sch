(symbol (lib_id "bfdac:TPS62850") (at 570.230 379.730 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board no) (dnp no) (uuid "a7bb55e0-fe13-43ff-8558-a953ff71512d") (property "Reference" "U855" (at 573.230 378.430 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "TPS628502" (at 573.230 381.030 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "Package_TO_SOT_SMD:SOT-583-8" (at 570.230 379.730 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 570.230 379.730 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "VAP09 0.9 V core buck: 2 A peak-current-mode sync buck, ~25 mOhm FETs -> ~90-92 % at 3.3->0.9 V/1 A (XU316 ds S14.6: I(VDD) max 1.11 A @ 800 MHz).  1 VIN 2 EN 3 MODE/SYNC 4 COMP/FSET 5 FB 6 PG 7 SW 8 GND.  MODE->VIN = forced PWM (no PFM burst smear on the island); COMP/FSET->GND via R861 = internal 2.25 MHz comp/freq; EN gated by U856 RESET = IO-before-core ordering; PG open-drain -> XMOS_RST_N wired-AND = last-rail-up releases reset" (at 570.230 379.730 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "TPS628502DRLR (RULED 2026-11-01, user)" (at 570.230 379.730 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "c7b2e0f1-524d-435b-8578-98bfcbd404fa")) (pin "2" (uuid "8cba0955-5014-45ae-99d7-ff6b55f7f0d5")) (pin "3" (uuid "8293eb71-0916-437c-a1ad-2b6d334ab62a")) (pin "4" (uuid "14262e7a-2083-4e3b-af49-9ea710c3cfdc")) (pin "7" (uuid "3d439cef-7c48-4f17-86dc-d37aaab64f91")) (pin "5" (uuid "c710e203-3905-427b-b37f-7a50063aba6e")) (pin "6" (uuid "5f3d24e6-63ac-4ccc-ab7c-8ddb57db2feb")) (pin "8" (uuid "31befad1-1b2e-4aca-9c52-465e58ba3471")) (instances (project "bfdac_analog" (path "/e214d457-f1e0-46ff-82ae-9c5220de0889/5180a859-fbe3-4de7-8d1c-6a68d391933f" (reference "U855") (unit 1)))))
