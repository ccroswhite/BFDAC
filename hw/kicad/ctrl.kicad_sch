(symbol (lib_id "bfdac:MAX22445") (at 129.540 214.630 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "b0abc42b-4414-4ef2-9892-7890dceaa2e0") (property "Reference" "U509" (at 132.540 213.330 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "MAX22445C" (at 132.540 215.930 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "bfdac:ADI_21-0042B_16_WSOIC" (at 129.540 214.630 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 129.540 214.630 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "3/1 digital isolator, default-HIGH outputs: U509 host-AP SPI (SCLK/CS_N/MOSI AP->FPGA, MISO back) - second FPGA SPI slave port (2026-11-14 dual-SPI: AP has direct register access; CS_N deselected with AP off). Side A = AP (VAP_IO), side B = FPGA (V18)" (at 129.540 214.630 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "MAX22445CAWE+" (at 129.540 214.630 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "3a7ced23-7910-41ab-bfa9-1aef7f7d00af")) (pin "3" (uuid "c787d4b2-0c42-440c-bc93-48ea07f6fcbe")) (pin "4" (uuid "ca87d667-d608-4208-8e81-04701234890e")) (pin "5" (uuid "cfec0f1f-a8bb-4313-ab75-ffaf5941688d")) (pin "6" (uuid "a4e2357e-eeaa-45f2-8967-23d1c7b27b6b")) (pin "7" (uuid "816b11ec-805b-4338-be22-82239b66d34e")) (pin "2" (uuid "bc451198-710e-4033-9e09-73cf082364a7")) (pin "8" (uuid "7a299342-0d66-4081-9872-34898e4b291f")) (pin "16" (uuid "6e5ffdaa-c38d-43b8-be48-71e3578022c6")) (pin "14" (uuid "ed489acf-bd90-4652-84c8-fbfaac7c0994")) (pin "13" (uuid "a28d70dc-d367-4733-842d-66dfe8089fcd")) (pin "12" (uuid "a90132c4-56fd-42d5-9f03-1647dff6ac99")) (pin "11" (uuid "4ac11374-66b2-4af5-b2fc-37794771ec40")) (pin "10" (uuid "32487d6f-c9cd-4b9b-b54a-e9cc0798679d")) (pin "9" (uuid "2779069f-a8d2-41bc-8f28-b840c5b6d1d4")) (pin "15" (uuid "a4b30828-592b-4207-8b3a-9c47e61e3a89")) (instances (project "bfdac_analog" (path "/c2f76d32-8933-4