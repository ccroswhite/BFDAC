(symbol (lib_id "bfdac:PCIe_x16") (at 39.370 119.380 0) (unit 2) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "5f9d9ae7-a120-4641-8fe9-29235f089210") (property "Reference" "J506" (at 42.370 118.080 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "AP DIG + PWR" (at 42.370 120.680 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "bfdac:PCIe_x16_Amphenol_10165968" (at 39.370 119.380 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 39.370 119.380 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "Amphenol PCIe x16 Gen6 vertical SMT card-edge socket, 164 pos (2x82) @1.0mm, 1.57mm card, 11.25mm above board, solder-retention hold-downs. Conn1/J506<->J7705 AP digital + power link; riser = user PCB with card-edge fingers both ends (SEAF-40/SEAR-40 struck 2026-11-16 - SEAR not purchasable). Side A = carrier power (V12SOM x20, GND, V33_IF_IN), side B = AP domain (signals, VAP_IO, GND_AP) per docs/PCIE_PIN_ASSIGNMENTS.md. Land = PCIe_x16_Amphenol_10165968 (SnapEDA-verified Amphenol drawing). West edge closest to FPGA, B.Cu." (at 39.370 119.380 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "10165968-113Y000LF" (at 39.370 119.380 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "A43" (uuid "a83db040-2354-4571-8bb5-bba29845da55")) (pin "A44" (uuid "53df3224-b096-4fae-ab4e-b239e29b43d8")) (pin "A45" (uuid "aea5a597-4cc2-4167-ba02-ab35e4d59323")) (pin "A46" (uuid "7934bb59-9fa3-4694-9cd5-7b7e4989a7a0")) (pin "A47" (uuid "9d5c0624-862a-4cc7-94df-45f14506e539")) (pin "A48" (uuid "3ec9de3e-7920-4c98-b259-ed0171a5238a")) (pin "A49" (uuid "ca8ddbeb-87b1-4412-b5fc-680d9bc0df68")) (pin "A50" (uuid "3fae70f0-dbf7-4705-b583-82c75bc1287e")) (pin "A51" (uuid "612d5fd9-499d-4957-a792-9dc0d0ca09ed")) (pin "A52" (uuid "3f9d27ea-c4b0-4415-b4e3-c5d721420826")) (pin "A53" (uuid "8440a343-076c-475c-8884-e3fcc46a3651")) (pin "A54" (uuid "86ce8b2d-1947-40ce-94