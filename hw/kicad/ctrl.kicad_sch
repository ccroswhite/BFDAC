(symbol (lib_id "bfdac:PCIe_x16") (at 39.370 240.030 0) (unit 4) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "4647c6bc-b452-45c4-be96-ef11a9ae034a") (property "Reference" "J506" (at 42.370 238.730 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "AP DIG + PWR" (at 42.370 241.330 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "bfdac:PCIe_x16_Amphenol_10165968" (at 39.370 240.030 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 39.370 240.030 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "Amphenol PCIe x16 Gen6 vertical SMT card-edge socket, 164 pos (2x82) @1.0mm, 1.57mm card, 11.25mm above board, solder-retention hold-downs. Conn1/J506<->J7705 AP digital + power link; riser = user PCB with card-edge fingers both ends (SEAF-40/SEAR-40 struck 2026-11-16 - SEAR not purchasable). Side A = carrier power (V12SOM x20, GND, V33_IF_IN), side B = AP domain (signals, VAP_IO, GND_AP) per docs/PCIE_PIN_ASSIGNMENTS.md. Land = PCIe_x16_Amphenol_10165968 (SnapEDA-verified Amphenol drawing). West edge closest to FPGA, B.Cu." (at 39.370 240.030 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "10165968-113Y000LF" (at 39.370 240.030 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "B43" (uuid "8419cef2-0813-43eb-9551-ac5af1d9c6fa")) (pin "B44" (uuid "eb4fa3c8-a3a1-490e-be46-b07f829dcfea")) (pin "B45" (uuid "30368d1f-ade8-43eb-88a0-d1876555af4c")) (pin "B46" (uuid "9705826a-6dcd-48bc-8fb3-435334c1f5ce")) (pin "B47" (uuid "6e0dbf86-8952-4151-890a-f60c89927a1d")) (pin "B48" (uuid "a3547207-8278-410f-b3a8-b661fbf4d579")) (pin "B49" (uuid "ccfb63ac-2f36-4d3e-aea8-d0bd44c9b635")) (pin "B50" (uuid "9aca205e-dc03-460b-9194-c4c9581b5cf0")) (pin "B51" (uuid "89a9152e-4c3b-455a-be28-f00d0e242bb6")) (pin "B52" (uuid "5eda8251-2a35-4d15-8e42-5fe1906cc5e1")) (pin "B53" (uuid "d4780bc3-9fe6-4e89-ae3b-095ebcf5ec8b")) (pin "B54" (uuid "ffaf7b21-61ac-4583-85