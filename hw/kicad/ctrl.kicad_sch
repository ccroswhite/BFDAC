(symbol (lib_id "bfdac:PCIe_x16") (at 39.370 180.340 0) (unit 3) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "a975c241-a1e0-44c5-97d2-11187bb56395") (property "Reference" "J506" (at 42.370 179.040 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "AP DIG + PWR" (at 42.370 181.640 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "bfdac:PCIe_x16_Amphenol_10165968" (at 39.370 180.340 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 39.370 180.340 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "Amphenol PCIe x16 Gen6 vertical SMT card-edge socket, 164 pos (2x82) @1.0mm, 1.57mm card, 11.25mm above board, solder-retention hold-downs. Conn1/J506<->J7705 AP digital + power link; riser = user PCB with card-edge fingers both ends (SEAF-40/SEAR-40 struck 2026-11-16 - SEAR not purchasable). Side A = carrier power (V12SOM x20, GND, V33_IF_IN), side B = AP domain (signals, VAP_IO, GND_AP) per docs/PCIE_PIN_ASSIGNMENTS.md. Land = PCIe_x16_Amphenol_10165968 (SnapEDA-verified Amphenol drawing). West edge closest to FPGA, B.Cu." (at 39.370 180.340 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "10165968-113Y000LF" (at 39.370 180.340 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "B1" (uuid "33a3608d-5753-4e6d-a464-ca9730ce5d6f")) (pin "B2" (uuid "a210f970-677e-4979-b0bf-86a3e5dc5ee4")) (pin "B3" (uuid "1a3cc5f4-d13c-45f0-bb44-501145e4fd6e")) (pin "B4" (uuid "ff69b87a-577a-42f7-869b-e68c615c86a1")) (pin "B5" (uuid "e748326d-b8fe-4a58-8fcf-24490753ce23")) (pin "B6" (uuid "a86693b4-3834-4bc2-8292-232a94e14908")) (pin "B7" (uuid "e822702f-ddc0-43c7-b335-45b56589fde2")) (pin "B8" (uuid "4dea2f11-52e9-4b19-a732-c1b66da216bf")) (pin "B9" (uuid "c8d683ef-203d-44d5-a256-d152252ff556")) (pin "B10" (uuid "0ea57179-5587-46dc-bc73-6a41a9675485")) (pin "B11" (uuid "ec8d4322-37ab-49d5-b2f2-b5cb05100844")) (pin "B12" (uuid "e56d1b21-1508-45ad-ba28-513e56