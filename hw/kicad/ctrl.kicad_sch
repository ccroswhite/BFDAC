(symbol (lib_id "bfdac:MAX22445") (at 129.540 250.190 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "42ec3eb6-b18d-478e-869c-ae38f98f1292") (property "Reference" "U513" (at 132.540 248.890 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "MAX22445F" (at 132.540 251.490 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "bfdac:ADI_21-0042B_16_WSOIC" (at 129.540 250.190 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 129.540 250.190 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "3/1 digital isolator, default-LOW outputs, sides swapped: U513 AP IRQ - side A = FPGA (V18): SPI_AP_IRQ_N -> AP; side B = AP (VAP_IO). IRQ_N reads asserted while the FPGA domain is down (same convention as U502); IN2/IN3/IN4 spare (tied), OUT2/OUT3/OUT4 NC" (at 129.540 250.190 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "MAX22445FAWE+" (at 129.540 250.190 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "9ef8893f-fc1a-4234-b2a6-ff5d1bbbf533")) (pin "3" (uuid "f4ab20af-0c6d-4b4b-8528-93326d167f5a")) (pin "4" (uuid "cb54e2e5-6de9-4320-98e5-005867180a65")) (pin "5" (uuid "985e58f5-4d54-487b-bf95-2bf49ff274e5")) (pin "6" (uuid "baf297b0-8357-4e9c-b22f-94dc140a92b2")) (pin "7" (uuid "726ff463-fc98-4b8e-a418-7cab593a7d74")) (pin "2" (uuid "ba5175f3-1721-4266-9ca4-80869f1041cb")) (pin "8" (uuid "4686b436-83e0-4462-ae10-0e48152c2b62")) (pin "16" (uuid "a6a9bf0a-ed38-46a8-82b4-8cb1644d0c04")) (pin "14" (uuid "ebb8ff3f-a892-43f1-ac88-621cf78fefdc")) (pin "13" (uuid "e02fc1fc-1ad2-406b-80fc-c06191ab30e4")) (pin "12" (uuid "35b3648e-98dd-425e-aa10-36f60f8d38be")) (pin "11" (uuid "d4f043ea-392d-4bcf-a6a6-e552d064b1b0")) (pin "10" (uuid "c442e7f1-1be4-4dea-a120-7d2d3a2d3c25")) (pin "9" (uuid "af4cd41d-3566-40b8-b977-2044d0af1f87")) (pin "15" (uuid "9c71e8a3-6fea-4443-8a0d-fbfe710c9766")) (instances (project "bfdac_analog" (path "/c2f76d32-8