(symbol (lib_id "bfdac:MAX22445") (at 129.540 110.490 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "aeaa6d48-9ecc-4701-9aaf-0b4ab2e45c00") (property "Reference" "U502" (at 132.540 109.190 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "MAX22445F" (at 132.540 111.790 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "bfdac:ADI_21-0042B_16_WSOIC" (at 129.540 110.490 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 129.540 110.490 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "3/1 digital isolator, default-LOW outputs: U502 I2S, sides swapped for FPGA-as-master - side A = FPGA (V18): BCLK/LRCLK/FPGA_IRQ_N -> AP; side B = AP (VAP_IO): SDATA -> FPGA. SDATA = silence with the AP off (bom 21, ruled 2026-10-09)" (at 129.540 110.490 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "MAX22445FAWE+" (at 129.540 110.490 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "dfa50625-8913-40a5-9632-273e04c17005")) (pin "3" (uuid "8590679f-8556-4368-891a-3e9af9b9c1d7")) (pin "4" (uuid "20260768-b564-4556-8739-4d8d4a63f51a")) (pin "5" (uuid "b9165c70-eec5-44fe-8d5a-e6c6d6b1b95b")) (pin "6" (uuid "85243ab8-312a-4a4d-871d-ae62d87341d4")) (pin "7" (uuid "9018604b-0364-4179-8b1b-d16a9113166a")) (pin "2" (uuid "f9c16489-513b-4518-8470-9a71a0576a55")) (pin "8" (uuid "0fceab19-857f-4066-a26b-389c09de7ac0")) (pin "16" (uuid "e1a3dda3-ca11-4eb7-94f8-fe5e52337f79")) (pin "14" (uuid "4c97bb72-4f02-4a74-a28d-cb121996b94f")) (pin "13" (uuid "87c9e5a3-a6e0-49f2-84a0-4b10e045b49d")) (pin "12" (uuid "d64ffe66-40c1-4ea0-8588-206c86abdd89")) (pin "11" (uuid "53db95fe-bf48-408c-a3c8-5a7a223f1910")) (pin "10" (uuid "d139b091-ff5d-4494-8e55-3f4adeffa327")) (pin "9" (uuid "4f9e4bd7-353b-447c-97b3-e6560ae2f4a6")) (pin "15" (uuid "b1b8c012-aee3-4085-8b63-f68f91fe1821")) (instances (project "bfdac_analog" (path "/c2f76d32-8933-4dec-a8e3-1f47d9ce5