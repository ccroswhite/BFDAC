(symbol (lib_id "Regulator_Linear:LT3094xMSE") (at 480.060 400.050 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "dbe552e7-f4f6-4214-b1ee-3f97782b15f6") (property "Reference" "U911" (at 483.060 398.750 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "LT3094" (at 483.060 401.350 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "Package_SO:MSOP-12-1EP_3x4.039mm_P0.65mm_EP1.651x2.845mm_ThermalVias" (at 480.060 400.050 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 480.060 400.050 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "-500 mA negative ultralow-noise LDO; SET = 100 uA x R_SET to GND gives -Vout; PGFB trips at -0.30 V so the SAME OUT->PGFB->GND divider as the positive parts works (442k/10k = -13.6 V trip on -15 V); EN/UV->IN, ILIM->GND, VIOC->GND (unused), PG -> PG_ALL" (at 480.060 400.050 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "LT3094EMSE#PBF" (at 480.060 400.050 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "12" (uuid "5476b9f9-9bbd-4bf7-8ed3-23b5dda0a99a")) (pin "13" (uuid "da08aa65-6469-4629-b166-143de8bf9361")) (pin "1" (uuid "1fe40b91-2086-469a-b4a6-3e69eaea2b08")) (pin "2" (uuid "78313a43-0e3c-42d1-acd7-a28a1ee17f91")) (pin "3" (uuid "b85af9bf-5c1f-4aa6-a4fd-eaa134b33406")) (pin "4" (uuid "e5d40d14-07fe-440e-8b17-23d780e2914a")) (pin "5" (uuid "c8086234-7a56-4e90-8e1e-f70fe082c328")) (pin "6" (uuid "5109e31e-f108-4fed-a0b2-c6ffc114ea1c")) (pin "7" (uuid "1ae29d59-c0fd-4b63-8b7e-bbde357721a5")) (pin "8" (uuid "8a33d06a-90b7-4fe3-be9b-15399c39a00d")) (pin "9" (uuid "77f979da-a716-44cc-bbf3-caab07f00f85")) (pin "10" (uuid "4de34b28-99f2-49ba-94c3-cebf4e2c891e")) (pin "11" (uuid "c8298659-30d3-4abd-8248-714c5781c934")) (instances (project "bfdac_analog" (path "/1f497322-6e5e-412f-8234-ba66143c84d1/920fdcdd-ab3b-4bff-aabf-4c0021bb084b" (reference "U911") (unit 1)))))
