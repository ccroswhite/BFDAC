(global_label "PADB_BASE_L" (shape passive) (at 374.650 351.790 270) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify right)) (uuid "83fe6eed-dbc3-41f9-a172-260b76c8dab3") (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 374.650 351.790 0) (hide yes) (effects (font (size 1.27 1.27)) (justify right))))
(text "PADB: 0.25 x (padb_ep - VEE15) = 3.575 V at 50 mA; diff-amp inputs sit at ~ -0.14 V (inside the OPA1656 CM range). Integrator polarity: I high -> PD_OUT high -> gate falls. Cpadb 100u (CORE C3) + R940 1k = 1.6 Hz gate filter; D902 bounds start-up current to ~57 mA. p/m share the gate: I_m = I_p +- Mpad V_th mismatch (static, calibrated)." (exclude_from_sim no) (at 290.000 372.000 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "b38cf182-9fd3-45a2-bc12-9cc4a3052f37"))
(text "PER-CHANNEL POL LDOs (dual-mono 17(m3)): LT3045 positive / LT3094 negative. EN/UV->IN (autostart), ILIM->GND (max limit), VIOC->GND (LT3094, upstream tracking unused). PGFB: OUT->Rtop->PGFB->10k->GND + 1 nF (+-0.30 V trip = ~90 % of rail). PG open-collector -> PG_ALL. SET: 100 uA x R_SET (+4.7 uF); VE1 SET is driven by U905A instead (stiff 7.21 V) with 100 nF." (exclude_from_sim no) (at 20.000 385.000 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "61548538-4594-40b6-98a2-39200441bad0"))
(symbol (lib_id "Regulator_Linear:LT3045xMSE") (at 59.690 400.050 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "fe77e4bc-8527-46d1-a9de-be6973dff085") (property "Reference" "U906" (at 62.690 398.750 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "LT3045" (at 62.690 401.350 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "Package_SO:MSOP-12-1EP_3x4.039mm_P0.65mm_EP1.651x2.845mm_ThermalVias" (at 59.690 400.050 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 59.690 400.050 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "500 mA ultra-low-noise LDO; SET = 100 uA x R_SET or driven (VE1); EN/UV->IN, ILIM->GND, PGFB divider MANDATORY (below +0.30 V the SET current jumps to 2 mA - PGFB->GND pegs the output at the rail!), PG open-collector -> PG_ALL" (at 59.690 400.050 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "LT3045EMSE#PBF" (at 59.690 400.050 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "1" (uuid "1b2e8264-d71a-4a65-850d-0ab8ee8d8f0f")) (pin "2" (uuid "f0e95556-5047-489c-be0f-5c53a0247824")) (pin "3" (uuid "94afb289-7ae2-4461-86df-5b451d5e43cb")) (pin "4" (uuid "8a0d50d3-6906-4641-b21e-1562e3c1d005")) (pin "5" (uuid "bcb5a10e-57ca-47d6-981f-a4c52667932d")) (pin "6" (uuid "4522e43c-21fc-4702-9ad6-f54cc7e7ce33")) (pin "7" (uuid "dc5a2481-7406-4826-a042-23ec200160d9")) (pin "8" (uuid "b5b783e7-63d9-4ffc-8aa5-035f1b9f70d9")) (pin "9" (uuid "58318673-cf37-476b-bd4f-ea6376d886a6")) (pin "10" (uuid "2202eaeb-06fe-4a12-a6ab-e5327e1eaa33")) (pin "11" (uuid "da123a5f-cd0b-49d2-8838-8053645f5f4b")) (pin "12" (uuid "e62b55aa-1099-4952-808f-0adfb3bf7ff8")) (pin "13" (uuid "ccd2c148-aa68-4619-864d-0ee4b766ab4e")) (instances (project "bfdac_analog" (path "/1f497322-6e5e-412f-8234-ba66143c84d1/920fdcdd-ab3b-4bff-aabf-4c0021bb084b" (reference "U906") (unit 1)))))
