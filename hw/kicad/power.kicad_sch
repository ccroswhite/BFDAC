(symbol (lib_id "bfdac:PCIe_x4") (at 650.240 299.720 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "e494b064-2c70-4fb1-88fb-a1661e2b07b2") (property "Reference" "J604" (at 653.240 298.420 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "PRE-REG" (at 653.240 301.020 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "bfdac:PCIe_x4_Amphenol_10165968" (at 650.240 299.720 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 650.240 299.720 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "Amphenol PCIe x4 Gen6 vertical SMT card-edge socket, 64 pos (2x32) @1.0mm, 1.57mm card, solder-retention hold-downs. Conn2/J603<->J7703 (north) + Conn3/J604<->J7704 (south) pre-reg rail links; riser = user PCB. Side B = P16A/N16A/V8P3 + GND, side A = V4P3 branch rails + GND per docs/PCIE_PIN_ASSIGNMENTS.md. Land = PCIe_x4_Amphenol_10165968 (verified vs Amphenol customer drawing 10165968 rev A: pad/SH/key/hold-down + DIM K=23.15 locating-hole position). B.Cu." (at 650.240 299.720 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "10165968-111T300LF" (at 650.240 299.720 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "A1" (uuid "fa949cda-731a-4550-aaf1-a7437adc2984")) (pin "A2" (uuid "4cddb0f7-927b-447c-b7bd-cd5f26e48231")) (pin "A3" (uuid "60fd66ff-6edf-4ba2-b6af-89984444d1d4")) (pin "A4" (uuid "4fc5b58e-bed4-4300-bd8c-85e8b31a047c")) (pin "A5" (uuid "69177be2-1a63-4bcc-8ff8-371374604b4b")) (pin "A6" (uuid "8c1abd0a-c1a7-424c-9bb9-d49125a88f26")) (pin "A7" (uuid "8aa669f4-ea65-4c6c-b0a3-1dc80d902988")) (pin "A8" (uuid "85d1b055-c693-46c2-a6cc-d2881106fb3d")) (pin "A9" (uuid "1fd6273d-2739-4862-a9e5-f4ec4dc373ec")) (pin "A10" (uuid "51d73b68-bd55-457d-b559-5bed797a2ce0")) (pin "A11" (uuid "7ee38512-a779-4213-b43c-3dd8147bd805")) (pin "A12" (uuid "cc2169a8-44ac-431a-8a9a-b93931ecc536")) (pin "A13" (uuid "67e48742-f394-4fb9-9a93-7ff2332f2cae"))