(symbol (lib_id "bfdac:PCIe_x4") (at 449.580 353.060 0) (unit 2) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "deaa60f4-d51b-481b-ac45-ab93692fae4c") (property "Reference" "J603" (at 452.580 351.760 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "PRE-REG" (at 452.580 354.360 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "bfdac:PCIe_x4_Amphenol_10165968" (at 449.580 353.060 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 449.580 353.060 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "Amphenol PCIe x4 Gen6 vertical SMT card-edge socket, 64 pos (2x32) @1.0mm, 1.57mm card, solder-retention hold-downs. Conn2/J603<->J7703 (north) + Conn3/J604<->J7704 (south) pre-reg rail links; riser = user PCB. Side B = P16A/N16A/V8P3 + GND, side A = V4P3 branch rails + GND per docs/PCIE_PIN_ASSIGNMENTS.md. Land = PCIe_x4_Amphenol_10165968 (verified vs Amphenol customer drawing 10165968 rev A: pad/SH/key/hold-down + DIM K=23.15 locating-hole position). B.Cu." (at 449.580 353.060 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "10165968-111T300LF" (at 449.580 353.060 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "B1" (uuid "7e48bc51-4d29-467f-b19a-f493392831df")) (pin "B2" (uuid "e9aad830-44a6-403f-9bd2-1814a121c489")) (pin "B3" (uuid "2d1db2d7-7efe-4453-a794-e14433c7e2ab")) (pin "B4" (uuid "e2ff6e1f-addb-4e8d-84d9-1ca141d651b7")) (pin "B5" (uuid "a4fb4624-a3a3-4435-931f-1255b04a153d")) (pin "B6" (uuid "0646f8c0-4f6c-4916-b20e-105b374beb3d")) (pin "B7" (uuid "44d4e3eb-9d21-4c14-8ed2-8b0512a9bb7d")) (pin "B8" (uuid "a6632d9b-5d2b-4ff4-a4f0-ca10fd2a6d9a")) (pin "B9" (uuid "efcc488d-6f98-4c2d-a998-6e659f48eeaf")) (pin "B10" (uuid "8837d2f1-f2fe-468f-bc07-af0c72dd1034")) (pin "B11" (uuid "16210c0e-5133-4ca3-ad33-4c09c7e13c96")) (pin "B12" (uuid "1d2851c3-4834-4b66-9db3-6a1c9d2d566c")) (pin "B13" (uuid "d7ac3dcd-d98b-4d8a-86b4-2950b4d9342b"))