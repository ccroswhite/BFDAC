(symbol (lib_id "bfdac:PCIe_x4") (at 650.240 353.060 0) (unit 2) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "793cbb33-f65d-4226-9e8d-e0b0278b1541") (property "Reference" "J604" (at 653.240 351.760 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "PRE-REG" (at 653.240 354.360 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "bfdac:PCIe_x4_Amphenol_10165968" (at 650.240 353.060 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 650.240 353.060 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "Amphenol PCIe x4 Gen6 vertical SMT card-edge socket, 64 pos (2x32) @1.0mm, 1.57mm card, solder-retention hold-downs. Conn2/J603<->J7703 (north) + Conn3/J604<->J7704 (south) pre-reg rail links; riser = user PCB. Side B = P16A/N16A/V8P3 + GND, side A = V4P3 branch rails + GND per docs/PCIE_PIN_ASSIGNMENTS.md. Land = PCIe_x4_Amphenol_10165968 (verified vs Amphenol customer drawing 10165968 rev A: pad/SH/key/hold-down + DIM K=23.15 locating-hole position). B.Cu." (at 650.240 353.060 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "10165968-111T300LF" (at 650.240 353.060 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "B1" (uuid "a25d5a3e-c509-4f12-a1ae-fee130c38b96")) (pin "B2" (uuid "bef6185a-8318-46a6-b052-0e68b9e113d2")) (pin "B3" (uuid "11545eeb-e7eb-4c69-a63c-af7e09f48b45")) (pin "B4" (uuid "a760f290-5bdd-42d2-889b-092e8af671cb")) (pin "B5" (uuid "5ce28501-0d8f-4c7f-9a42-79c8347bfdc3")) (pin "B6" (uuid "e71960c4-4b60-468a-bc14-6bcb80ef6944")) (pin "B7" (uuid "315bbf2c-1ac3-4dd3-90e6-de61ec06f9a4")) (pin "B8" (uuid "21c3e1b2-5a4f-4d91-be29-6e73a4210988")) (pin "B9" (uuid "87f43fa8-fb60-49a9-9cb8-27d6e7cf8952")) (pin "B10" (uuid "0cf2e156-4d1e-46df-aaaa-521c081138b8")) (pin "B11" (uuid "6943e144-914b-4cb6-86a0-5b954a96ad8e")) (pin "B12" (uuid "36002335-a556-4f8d-b700-582259c6dce5")) (pin "B13" (uuid "a9996554-699e-415d-928a-2648e933fbd7"))