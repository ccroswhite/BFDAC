(text "PRE-REG ENTRY (bom 17(d)/(l)/(n), option B + per-branch V4P3 2026-10-xx): pre-reg rails enter on two PCIe x4 card-edge sites - J603 north-center carries the L-branches, J604 south-center the R-branches. Shared rails (one source, two destinations): P16A (+16.2 V -> +15 V-class POLs), N16A (-16.2 V -> N15A/VEE15), V8P3 (+8.3 V -> VE1). V4P3 is FIVE INDEPENDENT TPS7A4501 outputs on the PREREG sheet, never tied together: V4P3_LA -> V33CLK + P5A_L, V4P3_LB -> V33D + P5A_R, V4P3_LC -> V33FF_L (FF bank split per channel 2026-10-12), V4P3_RA -> V33FF_R, V4P3_RB -> V33RLY (bom 17o)." (exclude_from_sim no) (at 20.000 17.000 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "2896b9ea-147a-49d8-95b6-96d79fea6675"))
(symbol (lib_id "bfdac:PCIe_x4") (at 449.580 299.720 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no) (uuid "959c280f-ac1d-4ab1-b2eb-6631a3b02fa1") (property "Reference" "J603" (at 452.580 298.420 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "PRE-REG" (at 452.580 301.020 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "bfdac:PCIe_x4_Amphenol_10165968" (at 449.580 299.720 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 449.580 299.720 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "Amphenol PCIe x4 Gen6 vertical SMT card-edge socket, 64 pos (2x32) @1.0mm, 1.57mm card, solder-retention hold-downs. Conn2/J603<->J7703 (north) + Conn3/J604<->J7704 (south) pre-reg rail links; riser = user PCB. Side B = P16A/N16A/V8P3 + GND, side A = V4P3 branch rails + GND per docs/PCIE_PIN_ASSIGNMENTS.md. Land = PCIe_x4_Amphenol_10165968 (verified vs Amphenol customer drawing 10165968 rev A: pad/SH/key/hold-down + DIM K=23.15 locating-hole position). B.Cu." (at 449.580 299.720 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "10165968-111T300LF" (at 449.580 299.720 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "A1" (uuid "8664c978-5b52-4676-b79b-395a80ae4f80")) (pin "A2" (uuid "a678b349-77e8-4b42-a38d-a33563b7f1a0")) (pin "A3" (uuid "22ffc52b-0209-4d5b-959b-098782bcaf87")) (pin "A4" (uuid "d916eb9d-3a3a-4b51-a4d4-952c04ca8b8c")) (pin "A5" (uuid "1998bacf-2408-4aaa-8435-2884e3eda979")) (pin "A6" (uuid "d5487937-5ea7-4101-847c-037f266ed560")) (pin "A7" (uuid "000c95f6-1d4e-4e0b-addf-f50cb9c1fd4c")) (pin "A8" (uuid "8ef0b7b0-286f-470f-953c-6a96d8f831af")) (pin "A9" (uuid "ed41b5ca-809f-495f-8b03-4c580eee68bd")) (pin "A10" (uuid "0fbfe89f-0f2b-4877-87d7-e957fe4a2e1a")) (pin "A11" (uuid "7307fcc6-8255-478c-8831-cda6d43b536c")) (pin "A12" (uuid "3c1aa24c-b780-4a82-bee6-c5bb9c8d5008")) (pin "A13" (uuid "4600f76a-f462-4ee8-ac42-c26179c04760"))