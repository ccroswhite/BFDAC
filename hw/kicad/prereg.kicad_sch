(symbol (lib_id "bfdac:PCIe_x16") (at 960.120 113.030 0) (unit 2) (exclude_from_sim no) (in_bom yes) (on_board no) (dnp no) (uuid "e61e80bd-00ca-4c89-9766-9d2f2787994e") (property "Reference" "J7705" (at 963.120 111.730 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "AP DIG + PWR" (at 963.120 114.330 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "bfdac:PCIe_x16_Amphenol_10165968" (at 960.120 113.030 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 960.120 113.030 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "Amphenol PCIe x16 Gen6 vertical SMT card-edge socket, 164 pos (2x82) @1.0mm, 1.57mm card, 11.25mm above board, solder-retention hold-downs. Conn1/J506<->J7705 AP digital + power link; riser = user PCB with card-edge fingers both ends (SEAF-40/SEAR-40 struck 2026-11-16 - SEAR not purchasable). Side A = carrier power (V12SOM x20, GND, V33_IF_IN), side B = AP domain (signals, VAP_IO, GND_AP) per docs/PCIE_PIN_ASSIGNMENTS.md. Land = PCIe_x16_Amphenol_10165968 (SnapEDA-verified Amphenol drawing). West edge closest to FPGA, B.Cu." (at 960.120 113.030 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "10165968-113Y000LF" (at 960.120 113.030 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "A43" (uuid "a2ff46c7-c7bd-4971-b556-41b087e1bbb4")) (pin "A44" (uuid "c029c296-ed78-4c34-8807-c9cec9f19136")) (pin "A45" (uuid "c28565f9-becc-4cda-8c27-69ef869ca824")) (pin "A46" (uuid "77dd1df4-a024-4253-b372-0c47ac2ab355")) (pin "A47" (uuid "d6905bd8-8f74-445f-9478-1d003df9138e")) (pin "A48" (uuid "62a4718b-25ee-4031-af77-c131f4432fb5")) (pin "A49" (uuid "d8ef9627-db6d-467b-add4-a1da375de168")) (pin "A50" (uuid "97716c98-f84e-431e-963f-a9d9b16faba6")) (pin "A51" (uuid "60958710-fa47-44b0-8219-9cf50fa12ad5")) (pin "A52" (uuid "fabfbdaf-4cb6-4e73-9bcd-75dcd0d2b159")) (pin "A53" (uuid "d71ae1e0-8028-4b5d-844f-023bad009c55")) (pin "A54" (uuid "dae2215b-20d2-