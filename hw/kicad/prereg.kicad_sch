(symbol (lib_id "bfdac:PCIe_x4") (at 560.070 59.690 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board no) (dnp no) (uuid "381e8667-d21d-4d62-8fd6-eec46484747c") (property "Reference" "J7703" (at 563.070 58.390 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "PRE-REG" (at 563.070 60.990 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "bfdac:PCIe_x4_Amphenol_10165968" (at 560.070 59.690 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 560.070 59.690 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "Amphenol PCIe x4 Gen6 vertical SMT card-edge socket, 64 pos (2x32) @1.0mm, 1.57mm card, solder-retention hold-downs. Conn2/J603<->J7703 (north) + Conn3/J604<->J7704 (south) pre-reg rail links; riser = user PCB. Side B = P16A/N16A/V8P3 + GND, side A = V4P3 branch rails + GND per docs/PCIE_PIN_ASSIGNMENTS.md. Land = PCIe_x4_Amphenol_10165968 (verified vs Amphenol customer drawing 10165968 rev A: pad/SH/key/hold-down + DIM K=23.15 locating-hole position). B.Cu." (at 560.070 59.690 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "10165968-111T300LF" (at 560.070 59.690 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "A1" (uuid "03512a29-599b-4142-a782-138b569464d4")) (pin "A2" (uuid "ea9b4724-707d-44f7-9679-b28c2449dc24")) (pin "A3" (uuid "3f60e3b8-13c3-464d-9887-a939d8669a1a")) (pin "A4" (uuid "82746127-3437-412d-997e-7c7f512ee0f2")) (pin "A5" (uuid "6bc4c1b1-ddb7-4191-9ee0-a182ecbecc34")) (pin "A6" (uuid "1aee1919-7725-419b-925d-f87c7d25acc3")) (pin "A7" (uuid "a520bc1f-957b-4e24-82fc-6407ae5d315b")) (pin "A8" (uuid "423810d4-10f3-4d43-8447-6756dedc08f7")) (pin "A9" (uuid "d16ef3de-79e3-42a5-bb49-4c57e7679e37")) (pin "A10" (uuid "b74c80d8-d1c1-4dbd-89a8-0f62a000ddf7")) (pin "A11" (uuid "9fbd84f2-3fbb-459d-91c3-cc22c508697f")) (pin "A12" (uuid "d45c80b4-7c33-4931-adde-51a1bc5895ff")) (pin "A13" (uuid "4693e346-e6aa-4d68-9d71-221ca16a4745")) (pin "