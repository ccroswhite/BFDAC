(symbol (lib_id "bfdac:PCIe_x4") (at 759.460 59.690 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board no) (dnp no) (uuid "1cb9cd5d-4696-427a-a8ef-341581bedaf8") (property "Reference" "J7704" (at 762.460 58.390 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "PRE-REG" (at 762.460 60.990 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "bfdac:PCIe_x4_Amphenol_10165968" (at 759.460 59.690 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 759.460 59.690 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "Amphenol PCIe x4 Gen6 vertical SMT card-edge socket, 64 pos (2x32) @1.0mm, 1.57mm card, solder-retention hold-downs. Conn2/J603<->J7703 (north) + Conn3/J604<->J7704 (south) pre-reg rail links; riser = user PCB. Side B = P16A/N16A/V8P3 + GND, side A = V4P3 branch rails + GND per docs/PCIE_PIN_ASSIGNMENTS.md. Land = PCIe_x4_Amphenol_10165968 (verified vs Amphenol customer drawing 10165968 rev A: pad/SH/key/hold-down + DIM K=23.15 locating-hole position). B.Cu." (at 759.460 59.690 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "10165968-111T300LF" (at 759.460 59.690 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "A1" (uuid "117e2358-3aca-4323-be6f-e7b716144b33")) (pin "A2" (uuid "a81e5c51-523c-44d4-94f9-5c2af497fea8")) (pin "A3" (uuid "c81c6621-b307-480f-b586-666e376b8e21")) (pin "A4" (uuid "60e632c6-c5af-41f3-b38e-8e2719046a90")) (pin "A5" (uuid "ebd07820-77d5-4d92-972e-7c0be13edce1")) (pin "A6" (uuid "fa57bed6-41b1-47b3-bdb5-ee3af0ce328c")) (pin "A7" (uuid "ac43e8f4-9154-41fe-b96f-131bfdf800f5")) (pin "A8" (uuid "1e15870a-21d1-4809-b7d7-ccd93557297f")) (pin "A9" (uuid "d409a04c-5725-4465-a5d3-a3bd865020a8")) (pin "A10" (uuid "08870cc6-9259-43fe-a9f8-e1f43f94e8e7")) (pin "A11" (uuid "65648ccb-b19a-4f9f-afbd-0bfe6649d615")) (pin "A12" (uuid "31437ffc-7793-4b80-b98b-eec6ceec9688")) (pin "A13" (uuid "8786ff44-7464-452a-8ebf-b13942c3331e")) (pin "