(symbol (lib_id "bfdac:PCIe_x16") (at 960.120 218.440 0) (unit 4) (exclude_from_sim no) (in_bom yes) (on_board no) (dnp no) (uuid "9d9a005f-b24a-4f1f-957b-562c23874d0d") (property "Reference" "J7705" (at 963.120 217.140 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "AP DIG + PWR" (at 963.120 219.740 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "bfdac:PCIe_x16_Amphenol_10165968" (at 960.120 218.440 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 960.120 218.440 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "Amphenol PCIe x16 Gen6 vertical SMT card-edge socket, 164 pos (2x82) @1.0mm, 1.57mm card, 11.25mm above board, solder-retention hold-downs. Conn1/J506<->J7705 AP digital + power link; riser = user PCB with card-edge fingers both ends (SEAF-40/SEAR-40 struck 2026-11-16 - SEAR not purchasable). Side A = carrier power (V12SOM x20, GND, V33_IF_IN), side B = AP domain (signals, VAP_IO, GND_AP) per docs/PCIE_PIN_ASSIGNMENTS.md. Land = PCIe_x16_Amphenol_10165968 (SnapEDA-verified Amphenol drawing). West edge closest to FPGA, B.Cu." (at 960.120 218.440 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "10165968-113Y000LF" (at 960.120 218.440 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "B43" (uuid "be7fc4e6-317f-42f6-bce4-cf99de2c308d")) (pin "B44" (uuid "72c47dad-922a-4bfa-90be-0359fab29868")) (pin "B45" (uuid "47b2bd60-3d97-4cd8-9367-ff0f4b0ca86a")) (pin "B46" (uuid "3d828af0-e456-4516-893f-8de252b39cae")) (pin "B47" (uuid "f4c3c95a-a53b-41b6-9530-f10f96aba7ca")) (pin "B48" (uuid "eaae1c54-0516-4c1b-ab93-bf16e20a1a34")) (pin "B49" (uuid "74f79c45-61b4-4828-b623-18908ec6621c")) (pin "B50" (uuid "2cd12983-a206-414c-99b7-13700b8ba8bb")) (pin "B51" (uuid "6647ab55-89ec-46fa-9f26-eca5310ab9df")) (pin "B52" (uuid "939b540d-0c6f-420a-acbc-5c61056afe0c")) (pin "B53" (uuid "ab2fe874-3440-45cf-b8a9-7ee5abfe61c3")) (pin "B54" (uuid "892ee001-682c-