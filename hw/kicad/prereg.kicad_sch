(symbol (lib_id "bfdac:PCIe_x4") (at 759.460 113.030 0) (unit 2) (exclude_from_sim no) (in_bom yes) (on_board no) (dnp no) (uuid "aa10e85b-7262-4b47-9473-9ef71855095a") (property "Reference" "J7704" (at 762.460 111.730 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "PRE-REG" (at 762.460 114.330 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "bfdac:PCIe_x4_Amphenol_10165968" (at 759.460 113.030 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 759.460 113.030 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "Amphenol PCIe x4 Gen6 vertical SMT card-edge socket, 64 pos (2x32) @1.0mm, 1.57mm card, solder-retention hold-downs. Conn2/J603<->J7703 (north) + Conn3/J604<->J7704 (south) pre-reg rail links; riser = user PCB. Side B = P16A/N16A/V8P3 + GND, side A = V4P3 branch rails + GND per docs/PCIE_PIN_ASSIGNMENTS.md. Land = PCIe_x4_Amphenol_10165968 (verified vs Amphenol customer drawing 10165968 rev A: pad/SH/key/hold-down + DIM K=23.15 locating-hole position). B.Cu." (at 759.460 113.030 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "10165968-111T300LF" (at 759.460 113.030 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "B1" (uuid "005b6243-94ee-4b85-a99b-8b7366f4e338")) (pin "B2" (uuid "ed54851c-e0eb-4f44-ba95-af3de69e94ab")) (pin "B3" (uuid "175366b9-c719-43d7-97e8-0153e0ab6b44")) (pin "B4" (uuid "d69aa088-eb49-4b17-b5b3-9f2ec04a27f4")) (pin "B5" (uuid "377440c3-6535-4280-ab9f-91c4e14307b5")) (pin "B6" (uuid "3a6b7ebc-0f23-4003-9576-e392716cfb6e")) (pin "B7" (uuid "e9b39e69-f9cd-490c-acf5-a58e1e802448")) (pin "B8" (uuid "0e8fc5ad-c0e7-49f0-9c70-8811c8a75432")) (pin "B9" (uuid "ddc65f7a-64e0-4169-b1b3-534dbbd71d44")) (pin "B10" (uuid "221ed483-252e-406f-9793-8bb91ff3021f")) (pin "B11" (uuid "238e841c-22c3-4b78-bc00-6108dbe0e514")) (pin "B12" (uuid "299b3add-f93d-47c0-b4ed-f065eb90aad7")) (pin "B13" (uuid "9e5e1aaf-0375-4df8-a509-624619557c1a"))