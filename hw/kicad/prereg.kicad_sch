(symbol (lib_id "bfdac:PCIe_x16") (at 960.120 59.690 0) (unit 1) (exclude_from_sim no) (in_bom yes) (on_board no) (dnp no) (uuid "ed072590-70e7-408a-89a1-874b1af00bd7") (property "Reference" "J7705" (at 963.120 58.390 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "AP DIG + PWR" (at 963.120 60.990 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "bfdac:PCIe_x16_Amphenol_10165968" (at 960.120 59.690 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 960.120 59.690 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "Amphenol PCIe x16 Gen6 vertical SMT card-edge socket, 164 pos (2x82) @1.0mm, 1.57mm card, 11.25mm above board, solder-retention hold-downs. Conn1/J506<->J7705 AP digital + power link; riser = user PCB with card-edge fingers both ends (SEAF-40/SEAR-40 struck 2026-11-16 - SEAR not purchasable). Side A = carrier power (V12SOM x20, GND, V33_IF_IN), side B = AP domain (signals, VAP_IO, GND_AP) per docs/PCIE_PIN_ASSIGNMENTS.md. Land = PCIe_x16_Amphenol_10165968 (SnapEDA-verified Amphenol drawing). West edge closest to FPGA, B.Cu." (at 960.120 59.690 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "10165968-113Y000LF" (at 960.120 59.690 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "A1" (uuid "5257acd4-7247-4939-970a-80ee5e0903f0")) (pin "A2" (uuid "85f2c44c-723d-4546-bc72-3b769a7229a4")) (pin "A3" (uuid "3f25d0de-6500-4035-a30d-bc1862042c68")) (pin "A4" (uuid "7c2edbac-4673-4942-a81a-793a2f05b94c")) (pin "A5" (uuid "7364a24b-fa35-44e5-a26f-aa2a91a19f27")) (pin "A6" (uuid "407ab61d-1206-40b3-9445-b85cad8a7e9c")) (pin "A7" (uuid "7750a09d-85e9-46a7-9952-57cee633cde7")) (pin "A8" (uuid "8934d730-1448-423c-98b4-077db182eb24")) (pin "A9" (uuid "d70d5174-b5cd-4afc-8da1-8f42022b1a9b")) (pin "A10" (uuid "33d07b57-bfd0-4e49-b923-038edb3bbb58")) (pin "A11" (uuid "7a01ac1e-b1e0-4034-b662-d60ef90f7ae1")) (pin "A12" (uuid "78702f21-e6bc-49e6-b04c-e86c1e