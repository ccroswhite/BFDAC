(symbol (lib_id "bfdac:PCIe_x16") (at 960.120 166.370 0) (unit 3) (exclude_from_sim no) (in_bom yes) (on_board no) (dnp no) (uuid "955eefc8-0439-4999-9d94-4713d4e22180") (property "Reference" "J7705" (at 963.120 165.070 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "AP DIG + PWR" (at 963.120 167.670 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "bfdac:PCIe_x16_Amphenol_10165968" (at 960.120 166.370 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 960.120 166.370 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "Amphenol PCIe x16 Gen6 vertical SMT card-edge socket, 164 pos (2x82) @1.0mm, 1.57mm card, 11.25mm above board, solder-retention hold-downs. Conn1/J506<->J7705 AP digital + power link; riser = user PCB with card-edge fingers both ends (SEAF-40/SEAR-40 struck 2026-11-16 - SEAR not purchasable). Side A = carrier power (V12SOM x20, GND, V33_IF_IN), side B = AP domain (signals, VAP_IO, GND_AP) per docs/PCIE_PIN_ASSIGNMENTS.md. Land = PCIe_x16_Amphenol_10165968 (SnapEDA-verified Amphenol drawing). West edge closest to FPGA, B.Cu." (at 960.120 166.370 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "10165968-113Y000LF" (at 960.120 166.370 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "B1" (uuid "05f70c15-32e3-49f5-9855-20da9d27ee88")) (pin "B2" (uuid "8b42fbf6-f52c-40fd-8f17-d775e35200b1")) (pin "B3" (uuid "66a89ee7-4070-4e43-8229-78fc57125c3f")) (pin "B4" (uuid "314718dc-ee13-4a90-ac1d-1e3ad1b3dd36")) (pin "B5" (uuid "2cbce539-6180-4a3b-8959-12782bd8070d")) (pin "B6" (uuid "41d2c13c-dbc2-42a2-b750-702efbe3654e")) (pin "B7" (uuid "9f8a2c1c-0829-4fd6-a54f-8783ae69bdbf")) (pin "B8" (uuid "d0365bd8-29ee-4bd2-a32d-5e2624c15d64")) (pin "B9" (uuid "f294f119-a6f8-4d82-816b-5a586818b20a")) (pin "B10" (uuid "09dee7a9-4717-45f5-a056-cb75519e98c2")) (pin "B11" (uuid "66e67723-b54f-4468-a477-b0b55a3e14d5")) (pin "B12" (uuid "8fcd264c-2b5c-4707-a7f8