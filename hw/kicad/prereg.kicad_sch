(symbol (lib_id "bfdac:PCIe_x4") (at 560.070 113.030 0) (unit 2) (exclude_from_sim no) (in_bom yes) (on_board no) (dnp no) (uuid "41c65c13-4384-4277-8812-5e2c810428e5") (property "Reference" "J7703" (at 563.070 111.730 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Value" "PRE-REG" (at 563.070 114.330 0) (effects (font (size 1.27 1.27)) (justify left))) (property "Footprint" "bfdac:PCIe_x4_Amphenol_10165968" (at 560.070 113.030 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Datasheet" "" (at 560.070 113.030 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "Description" "Amphenol PCIe x4 Gen6 vertical SMT card-edge socket, 64 pos (2x32) @1.0mm, 1.57mm card, solder-retention hold-downs. Conn2/J603<->J7703 (north) + Conn3/J604<->J7704 (south) pre-reg rail links; riser = user PCB. Side B = P16A/N16A/V8P3 + GND, side A = V4P3 branch rails + GND per docs/PCIE_PIN_ASSIGNMENTS.md. Land = PCIe_x4_Amphenol_10165968 (verified vs Amphenol customer drawing 10165968 rev A: pad/SH/key/hold-down + DIM K=23.15 locating-hole position). B.Cu." (at 560.070 113.030 0) (hide yes) (effects (font (size 1.27 1.27)))) (property "MPN" "10165968-111T300LF" (at 560.070 113.030 0) (hide yes) (effects (font (size 1.27 1.27)))) (pin "B1" (uuid "f5f61abe-e5a7-4c92-b64f-a51f2df23708")) (pin "B2" (uuid "44577294-81e5-43bc-a181-a0609c402a9f")) (pin "B3" (uuid "fb5112f6-3856-4974-9ca9-7b2ae4631888")) (pin "B4" (uuid "233e27f7-464b-45ae-8a9e-6b9c4dd27bf9")) (pin "B5" (uuid "0e94cfac-7127-4e9d-9c35-1ada05c6f38c")) (pin "B6" (uuid "293865f2-97ea-4069-b291-2b1b081cba71")) (pin "B7" (uuid "41fba9c4-1753-471a-89da-4c02063fd026")) (pin "B8" (uuid "fe13b73b-00b1-4527-9cda-13df16965252")) (pin "B9" (uuid "ae5af99c-c06c-4fc2-bb35-382a9b308fa6")) (pin "B10" (uuid "b364b8c3-3a47-449d-822e-d564ddd1c657")) (pin "B11" (uuid "c7489af0-c61e-45b5-af80-9ad3851e8901")) (pin "B12" (uuid "30c3db6d-dcc9-4dcd-b8c4-bcb6650fae4d")) (pin "B13" (uuid "2b34d476-5d9a-471f-829a-b84af1097fd1"))