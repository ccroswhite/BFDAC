# Vivado / XSim build artifacts
*.jou
*.log
*.pb
*.wdb
*.vcd
*.str
xsim.dir/
.Xil/
*.backup.jou
*.backup.log

# Synthesis checkpoints (large binaries, regenerable; exceed GitHub 100 MB limit)
*.dcp

# Questa/ModelSim library
Xilinx/work/

# XSim scratch directory (golden .mem sources live in Xilinx/Testbench/)
Xilinx/sim_stereo/

# Vivado batch-run reports and temp droppings (archived out-of-repo when kept)
Xilinx/*.rpt
Xilinx/.tmpCRC/
Xilinx/clockInfo.txt
Xilinx/tight_setup_hold_pins.txt
Xilinx/iter_*_CongestedCLBsAndNets.txt

# Vivado-generated IP output (regenerate via scripts/gen_ddr4_mig.tcl);
# keep only the source .xci configuration files
Xilinx/ip/**
!Xilinx/ip/*/
!Xilinx/ip/ddr4_0/ddr4_0.xci
!Xilinx/ip/axi_dwc_coef/axi_dwc_coef.xci

# Simulation scratch
Xilinx/Testbench/sim_work/
# DDR4 MIG example project + harvested memory model (scripts/gen_ddr4_example.tcl)
Xilinx/sim_mig/

# Python
__pycache__/
*.pyc

# Tool-run logs (logs/<job>.log + logs/<job>.done sentinel): readable by the IDE tools; json reports not kept
/logs/

*.out
*.err
*.stdout
*.stderr
*_stdout.txt
*_stderr.txt
*.dmp
dfx_runtime.txt
/Xilinx/e2e_*.txt
/Xilinx/Testbench/e2e_*.txt
/sim_run/e2e_*.txt

*.kicad_prl
*.kicad_sch-bak
*.kicad_pcb-bak
*.kicad_pro-bak
~*.lck
/hw/kicad/*-backups/
/hw/kicad/svg/
/hw/kicad/*.pdf
/hw/kicad/*.xml
/hw/kicad/erc.*
/hw/kicad/_erc.txt
/hw/kicad/bom_cell.csv

/datasheets/*.zip
/datasheets/_*
/bom17_dump.txt
/lmk00304.txt
/lmk1c1108.txt
/utils/thermal_board2d_*.npy

/.devin/config.local.json
/.env
/.env.*
!/.env.example
.DS_Store
Thumbs.db
Desktop.ini
