# =============================================================================
# acku15s_dac_top.xdc -- Vivado Timing & Physical Constraints
# Target : XCKU15P-2FFVE1517I on Alinx ACKU15S SOM
#
# Pin assignments regenerated by utils/gen_acku15s_xdc.py (ACKU15S-2):
#   connector signals <- datasheets/acku15s_pinmap_proposal.csv
#   DDR4/QSPI/clocks  <- ACKU15S V1.0 manual tables (fixed SoM pins,
#                      IO-name resolved via _ku15p_pkgpins.csv; the manual's
#                      printed pin column is misaligned at page breaks)
#   cascode col-mirrored J4 banks 69/70/71, control J1 banks 90/91,
#   cf flash J2 bank 65, qspi1 fixed SoM pins, LVCMOS18, cascode DRIVE=8.
#
# Clock, SPI, I2S, relay, DDR4, flash, and 128 cascode output constraints.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Primary Clocks
# -----------------------------------------------------------------------------

# 200 MHz SOM system clock (differential) -- drives SPI control plane (clk_200m domain).
# SoM oscillator on B94_L5_P/N = G12/G11 (HDGC, fixed on-module; not connector-routed).
create_clock -name clk_200m -period 5.000 [get_ports clk_200m_p]
set_property IOSTANDARD DIFF_HSTL_I_18 [get_ports {clk_200m_p clk_200m_n}]
set_property PACKAGE_PIN G12   [get_ports clk_200m_p];# IO_L5P_HDGC_94 SoM 200 MHz osc
set_property PACKAGE_PIN G11   [get_ports clk_200m_n];# IO_L5N_HDGC_94 SoM 200 MHz osc

# Master audio clock: carrier oscillator/fanout copy, single-ended LVCMOS18.
# Carries EITHER 45.1584 MHz (22.151 ns) or 49.152 MHz (20.345 ns); constrain
# at the faster 49.152 MHz rate so both families are timing-covered.
# GC pair B94_L6 (J4-B4/B3) on the FF end of the connector row: the carrier
# clock block faces the analog/FF side. Carrier drives mclk_p single-ended
# LVCMOS18 and leaves mclk_n reserved/no-connect. RTL uses IBUF on mclk_p.
create_clock -name clk_mclk -period 20.345 [get_ports mclk_p]

# mclk IBUF is on bank 94 HDIO; BUFGCE_HDIO->MMCM.CLKIN1 hops along the CMT
# column (no MMCM in the pin's clock region; clockplacer Place 30-716 waiver).
set_property CLOCK_DEDICATED_ROUTE ANY_CMT_COLUMN [get_nets mclk]
set_property IOSTANDARD LVCMOS18 [get_ports {mclk_p mclk_n}]
set_property PACKAGE_PIN F11   [get_ports mclk_p];# B94_L6_P J4-B4
set_property PACKAGE_PIN E11   [get_ports mclk_n];# B94_L6_N J4-B3

# Physical oscillator enable: 0 = 49.152 MHz, 1 = 45.1584 MHz.
# This is the inverse of the stream-rate code's family48 bit.
# Quasi-static control output; J1-A1 on the AP-facing end, drives the
# XO enables in the carrier clock block.
set_property IOSTANDARD LVCMOS18 [get_ports clk_sel]
set_property DRIVE       4       [get_ports clk_sel]
set_property SLEW        SLOW    [get_ports clk_sel]
set_property PACKAGE_PIN B4    [get_ports clk_sel];# B90_L10_N J1-A1
set_false_path -to [get_ports clk_sel]

# I2S BCLK is an output generated from cell_clk; DATA returns through isolation.
# BCLK is an FPGA output. Worst-case native rate is 384k: MCLK/2.
# Slower stream modes divide by 4/8/16. Physical return timing must be
# qualified against the programmed capture phase and isolator/AP delays.
set_property IOSTANDARD LVCMOS18 [get_ports i2s_bclk]

# -----------------------------------------------------------------------------
# 2. Generated Clocks (MMCM outputs -- Vivado auto-derives these;
#    explicit declarations improve reporting clarity)
# -----------------------------------------------------------------------------

# dsp_clk derived from the buffered XOCLK copy on mclk via the MMCM (no internal
# BUFGMUX; clk_sel controls the dual oscillator-enable network). At divide 3.25:
#   44.1k family: 903.168/3.25 = 277.898 MHz  (3.599 ns)
#   48k   family: 983.04 /3.25 = 302.474 MHz  (3.306 ns)
# clk_mclk is constrained at the faster (48k) rate, so dsp_clk timing covers both.
# NOTE (Step 5.1 synth fix): name-only create_generated_clock on the MMCM output
# pin RENAMES the auto-derived clock; all other properties are inherited.
create_generated_clock -name dsp_clk [get_pins u_clk_gen/u_mmcm/CLKOUT0]

# cell_clk -- MMCM CLKOUT1 = VCO/20 = mclk frequency (45.1584/49.152 MHz),
# phase-aligned to mclk by the MMCM feedback loop. Launches ONLY the 128
# cascode IOB registers (Round 29, todo #13).
create_generated_clock -name cell_clk [get_pins u_clk_gen/u_mmcm/CLKOUT1]

# -----------------------------------------------------------------------------
# 3. Clock Domain Crossing -- Synchronizers & Qualified Multi-Bit Buses
#
# All single-bit CDC signals use 2- or 3-stage (* ASYNC_REG = "TRUE" *) chains.
# Do not blanket-false-path clk_200m <-> dsp_clk: held multi-bit buses use
# explicit datapath-only max delays below so inter-clock skew stays bounded.
# -----------------------------------------------------------------------------

# clk_200m (SPI control plane) -> dsp_clk single-bit synchronizer first stages.
set_false_path -to [get_pins {
    unmute_sync_chain_reg[0]/D
    rate_sel_sync_chain_reg[0]/D
    level_req_sync_chain_reg[0]/D
    outsel_req_sync_chain_reg[0]/D
    outsel_target_sync_chain_reg[0]/D
    vol_tog_sync_reg[0]/D
    stream_automute_sync_reg[0]/D
    u_coef_subsys/boot_ok_sync_reg[0]/D
    u_coef_subsys/legacy_req_sync_reg[0]/D
    u_coef_subsys/filter_req_sync_reg[0]/D
}]

# clk_200m -> dsp_clk held multi-bit control buses (sampled after sync edge).
set_max_delay -datapath_only 5.0 \
    -from [get_clocks clk_200m] \
    -to   [get_cells {level_target_sync_chain_reg[0] level_target_sync_chain_reg[1] level_target_sync_chain_reg[2]}]
set_max_delay -datapath_only 5.0 \
    -from [get_cells -hierarchical -filter {NAME =~ sys_volume_q_reg*}] \
    -to   [get_cells {sys_volume_dsp_reg[*]}]
set_max_delay -datapath_only 5.0 \
    -from [get_cells -hierarchical -filter {NAME =~ u_ctrl_plane/i2s_rx_trim_reg*}] \
    -to   [get_cells {u_i2s_ingress/trim_meta_reg[*]}]
set_max_delay -datapath_only 5.0 \
    -from [get_clocks clk_200m] \
    -to   [get_cells {u_coef_subsys/req_data_dsp_reg[*]}]

# The applied interpolation/rate-shift bus changes only while the MMCM path
# reset is asserted, and remains static until the DSP and cell domains relock.
# Scope -to the destination clocks (2 objects instead of 226k sequential cells).
set_false_path \
    -from [get_cells {u_stream_rate/applied_rate_reg[1] u_stream_rate/applied_rate_reg[2]}] \
    -to   [get_clocks {dsp_clk cell_clk}]

# dsp_clk -> clk_200m single-bit status synchronizer first stages + status readback FFs.
set_false_path -to [get_pins {
    u_ctrl_plane/i2s_err_sync_reg[0]/D
    u_ctrl_plane/switch_busy_sync_reg[0]/D
    u_ctrl_plane/line_mute_sync_reg[0]/D
    u_ctrl_plane/hp_mute_sync_reg[0]/D
}]
set_max_delay -datapath_only 5.0 \
    -from [get_clocks dsp_clk] \
    -to   [get_cells {
        u_ctrl_plane/mgr_busy_r_reg
        u_ctrl_plane/bank_valid_r_reg
        u_ctrl_plane/coef_load_done_r_reg
        u_ctrl_plane/current_bank_id_r_reg[*]
    }]

# Serial DATA synchronizer (covers i2s_data, i2s_data2, and i2s_src_sel mux)
# and tagged launch-event crossing.
set_false_path -to [get_pins {u_i2s_ingress/data_sync_reg[0]/D}]
set_false_path -to [get_pins {u_i2s_ingress/enable_cell_reg[0]/D u_i2s_ingress/enable_sync_reg[0]/D u_i2s_ingress/valid_sync_reg[0]/D}]
set_max_delay -datapath_only 3.5 \
    -from [get_cells {u_i2s_ingress/launch_toggle_reg u_i2s_ingress/launch_bit_reg[*]}] \
    -to   [get_cells {u_i2s_ingress/launch_sync_reg[0] u_i2s_ingress/tag_pipe_reg[0][*]}]

# cell_clk -> dsp_clk (CDC audit, Step 4C.2)
# pace_tgl (cell_clk /8 tick toggle in dac_dsp_core section 6) crosses to the
# 3-FF pace_sync chain in dsp_clk. Toggle protocol tolerates 1 cycle of
# skew/metastability by construction -> datapath-only, one dsp_clk period.
set_max_delay -datapath_only 3.5 \
    -from [get_cells u_dsp_core/pace_tgl_reg] \
    -to   [get_cells {u_dsp_core/pace_sync_reg[0]}]

# Asynchronous external reset -- reset synchronizers handle the CDC
set_false_path -from [get_ports ext_rst_n]

# Async reset assertion; release is synchronized in DSP and serial cell domains.
set_false_path -to [get_pins -hierarchical -filter {NAME =~ *dsp_reset_sync_reg*/CLR || NAME =~ *dsp_rst_lvl1_n_reg*/CLR || NAME =~ *dsp_rst_tree_n_reg*/CLR || NAME =~ *cell_reset_reg*/CLR}]

# dsp_clk reset tree -> cell_clk reset pins (asserted for ~100 us while MMCM relocks).
set_false_path \
    -from [get_cells -hierarchical -filter {NAME =~ *dsp_reset_sync_reg* || NAME =~ *dsp_rst_lvl1_n_reg* || NAME =~ *dsp_rst_tree_n_reg*}] \
    -to   [get_pins -hierarchical -filter {NAME =~ u_i2s_ingress/* && (REF_PIN_NAME == CLR || REF_PIN_NAME == PRE)}]
set_false_path \
    -from [get_cells -hierarchical -filter {NAME =~ *dsp_reset_sync_reg* || NAME =~ *dsp_rst_lvl1_n_reg* || NAME =~ *dsp_rst_tree_n_reg*}] \
    -to   [get_pins -quiet -hierarchical -filter {NAME =~ u_dsp_core/pace_*_reg* && (REF_PIN_NAME == R || REF_PIN_NAME == CLR || REF_PIN_NAME == PRE)}]

# -----------------------------------------------------------------------------
# 4. SPI Control Bus — XMOS port (XMOS SPI master -> FPGA slave, clk_200m domain)
# -----------------------------------------------------------------------------
set_property IOSTANDARD LVCMOS18 [get_ports {spi_xmos_sclk spi_xmos_cs_n spi_xmos_mosi spi_xmos_miso}]
set_property SLEW       SLOW     [get_ports spi_xmos_miso]
# J1 rows A7-A11, bank 90 (AP-facing connector end).
# SPI_XMOS_* via U501 MAX22445C isolation on the carrier ctrl sheet.
set_property PACKAGE_PIN F1    [get_ports spi_xmos_sclk];# B90_L4_P J1-A9
set_property PACKAGE_PIN C2    [get_ports spi_xmos_cs_n];# B90_L9_P J1-A7
set_property PACKAGE_PIN E1    [get_ports spi_xmos_mosi];# B90_L4_N J1-A8
set_property PACKAGE_PIN D5    [get_ports spi_xmos_miso];# B90_L5_N J1-A11

# SPI signals are asynchronous to clk_200m; captured by 3-stage synchronizer
set_false_path -from [get_ports {spi_xmos_sclk spi_xmos_cs_n spi_xmos_mosi}]
set_false_path -to   [get_ports spi_xmos_miso]

# 4b. SPI Control Bus — AP port (host AP SPI master, J1 rows A17-A22 bank 91).
#     Isolated via U509 MAX22445C + U513 MAX22445F on the carrier ctrl sheet.
set_property IOSTANDARD LVCMOS18 [get_ports {spi_ap_sclk spi_ap_cs_n spi_ap_mosi spi_ap_miso spi_ap_irq_n}]
set_property SLEW       SLOW     [get_ports {spi_ap_miso spi_ap_irq_n}]
set_property PACKAGE_PIN B11   [get_ports spi_ap_sclk];# B91_L12_P J1-A19
set_property PACKAGE_PIN B10   [get_ports spi_ap_cs_n];# B91_L11_P J1-A17
set_property PACKAGE_PIN A11   [get_ports spi_ap_mosi];# B91_L12_N J1-A18
set_property PACKAGE_PIN C7    [get_ports spi_ap_miso];# B91_L7_N J1-A21
set_property PACKAGE_PIN C8    [get_ports spi_ap_irq_n];# B91_L7_P J1-A22
set_false_path -from [get_ports {spi_ap_sclk spi_ap_cs_n spi_ap_mosi}]
set_false_path -to   [get_ports {spi_ap_miso spi_ap_irq_n}]

# -----------------------------------------------------------------------------
# 5. FPGA IRQ (active-low, slow control signal to ARM)
# -----------------------------------------------------------------------------
set_property IOSTANDARD LVCMOS18 [get_ports fpga_irq_n]
set_property DRIVE       4       [get_ports fpga_irq_n]
set_property SLEW        SLOW    [get_ports fpga_irq_n]
set_property PACKAGE_PIN D6    [get_ports fpga_irq_n];# B90_L5_P J1-A12
set_false_path -to [get_ports fpga_irq_n]

# 5b. External reset from the application processor through isolation on the
#     carrier control sheet: J1-B11, bank 90.
set_property IOSTANDARD LVCMOS18 [get_ports ext_rst_n]
set_property PACKAGE_PIN F2    [get_ports ext_rst_n];# B90_L3_N J1-B11

# -----------------------------------------------------------------------------
# 6. FPGA-master I2S with asynchronously returning serial DATA
# -----------------------------------------------------------------------------
set_property IOSTANDARD LVCMOS18 [get_ports {i2s_bclk i2s_lrclk i2s_data i2s_data2}]
# J1 rows A2-A6, bank 90. BCLK/LRCLK are outputs; DATA is sampled with a
# qualified delay.
# i2s_data2 (J1-A6): second AP-domain source (host app processor) via U503
# ch2; selected by i2s_src_sel (SPI reg 0x1C bit 5).
set_property PACKAGE_PIN B5    [get_ports i2s_bclk];# B90_L10_P J1-A2
set_property PACKAGE_PIN C4    [get_ports i2s_lrclk];# B90_L8_N J1-A3
set_property PACKAGE_PIN C5    [get_ports i2s_data];# B90_L8_P J1-A4
set_property PACKAGE_PIN B2    [get_ports i2s_data2];# B90_L9_N J1-A6
set_property DRIVE 4 [get_ports {i2s_bclk i2s_lrclk}]
set_property SLEW SLOW [get_ports {i2s_bclk i2s_lrclk}]
set_property IOB TRUE [get_cells {u_i2s_ingress/i2s_bclk_reg u_i2s_ingress/i2s_lrclk_reg}]
create_generated_clock -name i2s_bclk -source [get_pins u_clk_gen/u_mmcm/CLKOUT1] -divide_by 2 [get_ports i2s_bclk]
set_max_delay -datapath_only 5.0 \
    -from [get_clocks cell_clk] \
    -to   [get_ports {i2s_bclk i2s_lrclk}]
set_false_path -to [get_pins {u_stream_rate/lock_sync_reg[0]/D stream_fault_sync_reg[0]/D}]
set_max_delay -datapath_only 5.0 \
    -from [get_cells {u_stream_rate/applied_rate_reg[*]}] \
    -to   [get_cells {u_coef_subsys/u_coef_loader/rate_r_reg[*]}]

# -----------------------------------------------------------------------------
# 7. Hardware Relay Outputs (slow, relay coil drive)
# -----------------------------------------------------------------------------
# Fig. 4d relay set: 2x mute, HP rails, 2x level tap (all coil drives via ULN buffer)
set_property IOSTANDARD LVCMOS18 [get_ports {relay_line_mute relay_hp_mute relay_hp_rails relay_level[*]}]
set_property DRIVE       12      [get_ports {relay_line_mute relay_hp_mute relay_hp_rails relay_level[*]}]
set_property SLEW        SLOW    [get_ports {relay_line_mute relay_hp_mute relay_hp_rails relay_level[*]}]
set_property PACKAGE_PIN E4    [get_ports relay_line_mute];# B90_L1_N J1-A13
set_property PACKAGE_PIN E5    [get_ports relay_hp_mute];# B90_L1_P J1-A14
set_property PACKAGE_PIN A6    [get_ports relay_hp_rails];# B90_L12_N J1-B1
set_property PACKAGE_PIN B6    [get_ports {relay_level[0]}];# B90_L12_P J1-B2
set_property PACKAGE_PIN A3    [get_ports {relay_level[1]}];# B90_L11_N J1-B3
set_property PACKAGE_PIN F3    [get_ports pg_all];# B90_L3_P J1-B12
set_property PACKAGE_PIN E3    [get_ports test_select_n];# B90_L2_N J1-B13
set_property PACKAGE_PIN F4    [get_ports test_step_n];# B90_L2_P J1-B14
set_property PACKAGE_PIN A9    [get_ports test_led];# B91_L11_N J1-A16
set_property IOSTANDARD LVCMOS18 [get_ports {pg_all test_select_n test_step_n test_led}]
set_property DRIVE 4 [get_ports test_led]
set_property SLEW SLOW [get_ports test_led]
set_false_path -from [get_ports {pg_all test_select_n test_step_n}]
set_false_path -to [get_ports test_led]
set_false_path -to [get_ports {relay_line_mute relay_hp_mute relay_hp_rails relay_level[*]}]

# -----------------------------------------------------------------------------
# 8. Cascode Cell Outputs (1 pin per cell, 64 per channel, 128 total)
#
# Round 29 architecture (bom.md 1.2, Fig. 1b): these 128 LVCMOS18 outputs are
# DATA into the external MC100EP52 differential LVPECL reclock FFs (resistive
# 3.6k/1k shift into each FF D input vs external ~2.1 V threshold rail;
# the EP52 has no V_BB pin - Round 30 finding, bom.md 1.2). The FF resamples on the
# OCXO-derived XOCLK fanout clock and its Q/~Q pair drives the DMMT5551 steering
# cell bases through 100R/165R networks. No CMOS translator.
#
# Timing (todo #13, closed Round 29; hold fix 2026-08-14):
#   - IOB FFs are clocked by cell_clk (MMCM CLKOUT1 = mclk rate, CLKOUT1_PHASE
#     = 90 deg -> launch edge 5.09 ns after the mclk/ff_clk edge; same selected
#     XOCLK through the LMK1C1108 fanout).
#   - ff_clk below is a VIRTUAL clock representing the MC100EP52 clock pin.
#     Launch on cell_clk edge N (t = 5.09 ns), capture on ff_clk edge N+1
#     (t = 20.345 ns): 15.26 ns setup budget, 5.09 ns of real hold margin
#     against edge N.
#   - Output delay numbers DATASHEET-VERIFIED (Round 30, bom.md 1.4):
#       max = board flight 1.0 + shift network 0.1 + EP52 setup 0.2
#             + fanout skew margin 1.0                       = 2.3  -> 2.5 pad
#       min = -(EP52 hold 0.2 + fanout skew margin 1.0)      = -1.2 -> -1.5 pad
#   - dsp_clk -> cell_clk crossing uses a toggle-handshake CDC in
#     dac_dsp_core (staging bus stable ~8 cell_clk per 6.144 MHz DEM update);
#     constrain datapath-only so Vivado does not chase the 89 ps related-clock
#     edge alignment.
# -----------------------------------------------------------------------------
set_property IOSTANDARD LVCMOS18 [get_ports {cascode_l[*] cascode_r[*]}]
set_property DRIVE       8       [get_ports {cascode_l[*] cascode_r[*]}]
set_property SLEW        FAST    [get_ports {cascode_l[*] cascode_r[*]}]
set_property IOB         TRUE    [get_cells {u_dsp_core/cascode_iob_l_reg[*] u_dsp_core/cascode_iob_r_reg[*]}]

# CDC: dsp_clk staging/toggle -> cell_clk sync/capture (toggle handshake)
set_max_delay -datapath_only 3.5 \
    -from [get_cells {u_dsp_core/staging_l_reg[*] u_dsp_core/staging_r_reg[*] u_dsp_core/dem_update_tgl_reg}] \
    -to   [get_cells {u_dsp_core/cell_cap_l_reg[*] u_dsp_core/cell_cap_r_reg[*] u_dsp_core/tgl_sync_reg[0]}]

# Async reset into the cell_clk reset synchronizer (recovery/removal handled
# by the 2-FF synchronizer itself)
set_false_path -to [get_pins -hierarchical -filter {NAME =~ *cell_rst_sync_reg*/CLR}]

# Virtual clock: external MC100EP52 clock pin (same rate/phase as mclk)
create_clock -name ff_clk -period 20.345

set_output_delay -clock ff_clk -max  2.500 [get_ports {cascode_l[*] cascode_r[*]}]
set_output_delay -clock ff_clk -min -1.500 [get_ports {cascode_l[*] cascode_r[*]}]

# Package pins: J4 (FF-facing end), column-mirrored -- cascode_l on cols
# A/B, cascode_r on cols C/D, bit-for-bit row mirrored (L[2i]/L[2i+1] at row N
# mirrors R[2i]/R[2i+1] at row N) so carrier trace lengths are symmetric.
# L: banks 71/70/69, R: banks 71/70/69 (same VCCIO via J3).
set_property PACKAGE_PIN K14   [get_ports {cascode_l[0]}];# B71_L6_N J4-A14
set_property PACKAGE_PIN J16   [get_ports {cascode_l[1]}];# B71_L5_N J4-B14
set_property PACKAGE_PIN K15   [get_ports {cascode_l[2]}];# B71_L6_P J4-A15
set_property PACKAGE_PIN K16   [get_ports {cascode_l[3]}];# B71_L5_P J4-B15
set_property PACKAGE_PIN F16   [get_ports {cascode_l[4]}];# B71_L14_N J4-A17
set_property PACKAGE_PIN G16   [get_ports {cascode_l[5]}];# B71_L11_N J4-B17
set_property PACKAGE_PIN F17   [get_ports {cascode_l[6]}];# B71_L14_P J4-A18
set_property PACKAGE_PIN G17   [get_ports {cascode_l[7]}];# B71_L11_P J4-B18
set_property PACKAGE_PIN F21   [get_ports {cascode_l[8]}];# B70_L11_N J4-A20
set_property PACKAGE_PIN B20   [get_ports {cascode_l[9]}];# B70_L20_N J4-B20
set_property PACKAGE_PIN G21   [get_ports {cascode_l[10]}];# B70_L11_P J4-A21
set_property PACKAGE_PIN C20   [get_ports {cascode_l[11]}];# B70_L20_P J4-B21
set_property PACKAGE_PIN M20   [get_ports {cascode_l[12]}];# B70_L2_N J4-A23
set_property PACKAGE_PIN D20   [get_ports {cascode_l[13]}];# B70_L18_N J4-B23
set_property PACKAGE_PIN M19   [get_ports {cascode_l[14]}];# B70_L2_P J4-A24
set_property PACKAGE_PIN E20   [get_ports {cascode_l[15]}];# B70_L18_P J4-B24
set_property PACKAGE_PIN K21   [get_ports {cascode_l[16]}];# B70_L6_N J4-A26
set_property PACKAGE_PIN M22   [get_ports {cascode_l[17]}];# B70_L1_N J4-B26
set_property PACKAGE_PIN K20   [get_ports {cascode_l[18]}];# B70_L6_P J4-A27
set_property PACKAGE_PIN M21   [get_ports {cascode_l[19]}];# B70_L1_P J4-B27
set_property PACKAGE_PIN H22   [get_ports {cascode_l[20]}];# B70_L7_N J4-A29
set_property PACKAGE_PIN J21   [get_ports {cascode_l[21]}];# B70_L8_N J4-B29
set_property PACKAGE_PIN J22   [get_ports {cascode_l[22]}];# B70_L7_P J4-A30
set_property PACKAGE_PIN J20   [get_ports {cascode_l[23]}];# B70_L8_P J4-B30
set_property PACKAGE_PIN L22   [get_ports {cascode_l[24]}];# B70_L4_N J4-A32
set_property PACKAGE_PIN D21   [get_ports {cascode_l[25]}];# B70_L17_N J4-B32
set_property PACKAGE_PIN L21   [get_ports {cascode_l[26]}];# B70_L4_P J4-A33
set_property PACKAGE_PIN E21   [get_ports {cascode_l[27]}];# B70_L17_P J4-B33
set_property PACKAGE_PIN L24   [get_ports {cascode_l[28]}];# B70_L3_N J4-A35
set_property PACKAGE_PIN D23   [get_ports {cascode_l[29]}];# B70_L16_N J4-B35
set_property PACKAGE_PIN L23   [get_ports {cascode_l[30]}];# B70_L3_P J4-A36
